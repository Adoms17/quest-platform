{
  "name": "qvesta-market-stage",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "stage-market.qvesta.ru",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "npm run build -- --config vite.stage.config.mjs --mode staging && node ../scripts/market-stage-release.mjs check"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
