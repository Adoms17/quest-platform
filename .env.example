# Используйте только anon/publishable key. service_role key во frontend запрещён.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Публичный browser key Geoapify, ограниченный доменами приложения.
# Необязателен: без него offline-карта использует встроенную SVG-схему.
VITE_GEOAPIFY_API_KEY=your-domain-restricted-geoapify-key
